function originLIB:ShowIntro(text, duration)
    duration = duration or 2.5

    local SplashGui = Instance.new("ScreenGui")
    SplashGui.Name = "originLIB_Intro"
    SplashGui.ResetOnSpawn = false
    protectUI(SplashGui)

    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(0, 280, 0, 65)
    Card.Position = UDim2.new(0.5, -140, 0.5, -32)
    Card.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    Card.BorderSizePixel = 0
    Card.ClipsDescendants = true
    Card.BackgroundTransparency = 1
    Card.Parent = SplashGui

    local CardCorner = Instance.new("UICorner")
    CardCorner.CornerRadius = UDim.new(0, 10)
    CardCorner.Parent = Card

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(140, 100, 255)
    Stroke.Thickness = 1.5
    Stroke.Transparency = 1
    Stroke.Parent = Card

    local MainText = Instance.new("TextLabel")
    MainText.Size = UDim2.new(1, 0, 0, 35)
    MainText.Position = UDim2.new(0, 0, 0, 5)
    MainText.BackgroundTransparency = 1
    MainText.Text = text or "originLIB"
    MainText.TextColor3 = Color3.fromRGB(255, 255, 255)
    MainText.TextSize = 16
    MainText.Font = Enum.Font.GothamBold
    MainText.TextTransparency = 1
    MainText.Parent = Card

    local PoweredText = Instance.new("TextLabel")
    PoweredText.Size = UDim2.new(1, 0, 0, 20)
    PoweredText.Position = UDim2.new(0, 0, 1, 5)
    PoweredText.BackgroundTransparency = 1
    PoweredText.Text = "Powered by originLIB"
    PoweredText.TextColor3 = Color3.fromRGB(140, 100, 255)
    PoweredText.TextSize = 11
    PoweredText.Font = Enum.Font.GothamMedium
    PoweredText.TextTransparency = 1
    PoweredText.Parent = Card

    tween(Card, {BackgroundTransparency = 0.05}, 0.3)
    tween(Stroke, {Transparency = 0}, 0.3)
    tween(MainText, {TextTransparency = 0}, 0.3)

    task.wait(0.2)
    tween(PoweredText, {Position = UDim2.new(0, 0, 0, 36), TextTransparency = 0}, 0.4)

    task.wait(duration)

    tween(PoweredText, {Position = UDim2.new(0, 0, 1, 5), TextTransparency = 1}, 0.3)
    task.wait(0.1)
    tween(Card, {BackgroundTransparency = 1}, 0.3)
    tween(Stroke, {Transparency = 1}, 0.3)
    local fadeOut = tween(MainText, {TextTransparency = 1}, 0.3)

    fadeOut.Completed:Connect(function()
        SplashGui:Destroy()
    end)
end

-- ==========================================
-- 2. ГЛОБАЛЬНЫЙ UNLOAD (совместим с v4.0)
-- ==========================================

-- Регистрирует "общескриптовую" функцию очистки, не привязанную к конкретному
-- окну (например, отключение RenderStepped, остановка циклов и т.д.)
function originLIB:OnUnload(taskFunc)
    if type(taskFunc) == "function" then
        table.insert(self.GlobalUnloadTasks, taskFunc)
    end
end

-- Полная выгрузка: сворачивает ВСЕ открытые окна + общескриптовые таски.
-- Поведение соответствует originLIB:Unload() из v4.0 (обратная совместимость).
function originLIB:Unload()
    -- Копия списка, т.к. Window:Unload() удаляет себя из originLIB.Windows
    local windowsSnapshot = table.clone(self.Windows)
    for _, window in ipairs(windowsSnapshot) do
        window:Unload()
    end

    for _, taskFunc in ipairs(self.GlobalUnloadTasks) do
        safeCall(taskFunc)
    end
    self.GlobalUnloadTasks = {}

    if self.NotifGui then
        self.NotifGui:Destroy()
        self.NotifGui = nil
        self.NotificationHolder = nil
    end

    if self.BlurEffect then
        self.BlurEffect:Destroy()
        self.BlurEffect = nil
    end
    self._blurEnabled = false
end

-- Явный алиас — то же самое, что originLIB:Unload(), но название однозначно
-- говорит о многооконном сценарии.
function originLIB:UnloadAll()
    self:Unload()
end

-- ==========================================
-- 3. СОЗДАНИЕ ОКНА
-- ==========================================
function originLIB:Window(config)
    local options = type(config) == "table" and config or { Title = tostring(config or "originLIB") }
    local window = setmetatable({}, WindowClass)

    -- Реестры конкретно этого окна (никакого шаринга между окнами)
