    table.insert(self.Window.ThemeElements.Accent, Fill)

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = Fill

    -- Круглая "ручка" на конце заполненной части — привычный визуальный якорь
    -- для перетаскивания, а не просто край цветной полосы.
    local Thumb = Instance.new("Frame")
