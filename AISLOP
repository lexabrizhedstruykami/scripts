    ResizeHandle.Parent = MainFrame

    local allowResizeSetting = false
    local isMinimized = false

    -- ===== Централизованный ввод (PERF + FIX) =====
    -- Вместо того чтобы каждый Slider/ColorPicker/Keybind вешал свои собственные
    -- постоянные подключения к UserInputService (утечка), окно держит РОВНО
    -- три подключения на весь свой жизненный цикл и диспатчит события сама.
    -- Любой элемент, которому нужно "потаскать мышью", просто кладёт в
    -- window.DragState таблицу вида {Update = function(input) ... end}
    -- в момент начала перетаскивания (через свой ЛОКАЛЬНЫЙ InputBegan —
    -- он самоочищается вместе с инстансом и утечки не создаёт).

    local function track(conn)
        table.insert(window.Connections, conn)
        return conn
    end

    track(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and window.DragState then
            window.DragState.Update(input)
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            window.DragState = nil
        end
    end))

    track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        -- Режим захвата новой клавиши для Keybind-элемента
        if window.ListeningKeybind then
            if input.KeyCode == Enum.KeyCode.Escape then
                window.ListeningKeybind.Cancel()
            else
                window.ListeningKeybind.Bind(input.KeyCode)
            end
            window.ListeningKeybind = nil
            return
        end

        if gameProcessed then return end

        local bucket = window.KeybindMap[input.KeyCode]
        if bucket then
            for _, callback in ipairs(bucket) do
                safeCall(callback, input.KeyCode)
            end
        end
    end))

    -- Dragging окна за шапку
    local dragStartPos, dragStartFramePos
    track(TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragStartPos = input.Position
            dragStartFramePos = MainFrame.Position
            window.DragState = {
                Update = function(inp)
                    local delta = inp.Position - dragStartPos
                    MainFrame.Position = UDim2.new(
                        dragStartFramePos.X.Scale, dragStartFramePos.X.Offset + delta.X,
                        dragStartFramePos.Y.Scale, dragStartFramePos.Y.Offset + delta.Y
                    )
                end
            }
        end
    end))

    -- Resizing за уголок
    track(ResizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not isMinimized then
            local resizeStart = input.Position
            local startSize = MainFrame.AbsoluteSize
            window.DragState = {
                Update = function(inp)
                    local delta = inp.Position - resizeStart
                    local newX = math.max(400, startSize.X + delta.X)
                    local newY = math.max(250, startSize.Y + delta.Y)
                    currentSize = Vector2.new(newX, newY)
                    MainFrame.Size = UDim2.new(0, currentSize.X, 0, currentSize.Y)
                end
            }
        end
    end))

    MinimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            ResizeHandle.Visible = false
            tween(MainFrame, {Size = UDim2.new(0, currentSize.X, 0, 35)})
        else
            if allowResizeSetting then ResizeHandle.Visible = true end
            tween(MainFrame, {Size = UDim2.new(0, currentSize.X, 0, currentSize.Y)})
        end
    end)

    local tabsHidden = false
    ToggleTabsBtn.MouseButton1Click:Connect(function()
