    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    -- Pill-переключатель (track + скользящий круглый knob) вместо плоского
    -- квадратного индикатора — привычнее визуально и лучше читает состояние.
    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(0, 34, 0, 18)
    Track.Position = UDim2.new(1, -44, 0.5, -9)
    Track.BackgroundColor3 = state and self.Window.Theme.Accent or Color3.fromRGB(50, 50, 65)
    Track.Parent = Frame
    if state then table.insert(self.Window.ThemeElements.Accent, Track) end

    local TrackCorner = Instance.new("UICorner")
    TrackCorner.CornerRadius = UDim.new(1, 0)
    TrackCorner.Parent = Track

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 14, 0, 14)
    Knob.AnchorPoint = Vector2.new(0, 0.5)
    Knob.Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Parent = Track

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local Clicker = Instance.new("TextButton")
    Clicker.Size = UDim2.new(1, 0, 1, 0)
    Clicker.BackgroundTransparency = 1
    Clicker.Text = ""
    Clicker.Parent = Frame

    -- FIX: раньше в глобальный реестр Toggles клался статичный снимок состояния
    -- (State = state), который никогда не обновлялся после создания элемента,
    -- из-за чего Unload мог не выключить фактически включённый тоггл.
    -- Теперь IsOn() читает `state` через замыкание — значение всегда актуально.
    local function setState(newState)
        state = newState
        tween(Track, {BackgroundColor3 = state and self.Window.Theme.Accent or Color3.fromRGB(50, 50, 65)})
        tween(Knob, {Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)}, 0.15)
        safeCall(callback, state)
    end

    Clicker.MouseButton1Click:Connect(function()
        setState(not state)
    end)

    table.insert(self.Window.Toggles, {
        IsOn = function() return state end,
        SetState = setState
    })

    return { SetState = setState, IsOn = function() return state end }
end

