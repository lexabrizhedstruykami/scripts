    PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 16)
    end)

    local function activate()
        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            t.Btn:SetAttribute("IsActiveTab", false)
            tween(t.Btn, {BackgroundColor3 = self.Theme.Element})
            tween(t.Label, {TextColor3 = Color3.fromRGB(160, 160, 180)})
            tween(t.Indicator, {Size = UDim2.new(0, 0, 1, -10)})
