-- ==========================================
--               originLIB v5.0
--   Rayfield Edition — Refactored & Optimized
-- ==========================================
--
-- ИЗМЕНЕНИЯ v4.0 -> v5.0:
--  [FIX]     Toggle корректно синхронизирует своё состояние с реестром Unload
--            (раньше состояние "замораживалось" на момент создания, поэтому
--             авто-выключение при Unload часто не срабатывало).
--  [FIX]     Slider реагирует на клик только по самой полосе (Bar), а не по всей
--            строке — раньше клик по подписи тоже двигал ползунок.
--  [FIX]     Захват клавиши в Keybind можно отменить (Escape или клик по другому
--            элементу), раньше "Press key..." мог зависнуть навсегда.
--  [PERF]    Все подключения к UserInputService централизованы: 1 InputChanged +
--            1 InputEnded + 1 InputBegan НА ОКНО, а не по одному на каждый
--            Slider/ColorPicker/Keybind. Раньше каждый созданный элемент навсегда
--            добавлял подключение к глобальному сервису — это утечка памяти и
--            деградация производительности на больших конфигах.
--  [PERF]    Keybind'ы диспатчатся через hash-map по KeyCode (O(1)), а не через
--            N сравнений строк на каждое нажатие клавиши.
--  [PERF]    Все подключения, которые переживают свой Instance (см. выше),
--            трекаются и гарантированно отключаются в Unload.
--  [FEATURE] Полноценная поддержка нескольких окон: originLIB:Window() создаёт
--            независимый инстанс (своя тема, свои тогглы, свой Unload).
--  [FEATURE] window:OnUnload / window:Unload — точечная очистка одного окна,
--            не трогая остальные. originLIB:OnUnload / originLIB:Unload по-прежнему
--            работают "глобально" (как в v4.0) — сворачивают вообще всё.
--  [FEATURE] originLIB:UnloadAll() — явный алиас на полную выгрузку.
--  [FEATURE] Новые элементы: Tab:Label, Tab:Divider, Tab:MultiDropdown.
--  [FEATURE] Dropdown автоматически закрывается при открытии другого Dropdown
--            в том же окне.
--  [FIX]     Пользовательские OnUnload-таски и все callback'и элементов обёрнуты
--            в pcall — ошибка в одном колбэке больше не ломает весь Unload/UI.
--  [FIX]     Библиотека больше не спавнит демо-интерфейс сама при loadstring —
--            демо вынесено в блок в самом низу файла и закомментировано.
--
-- ИЗМЕНЕНИЯ v5.1 "Visual Overhaul":
--  - Мягкая тень + акцентное свечение по контуру окна.
--  - Шапка окна с лёгким градиентом, разделительной линией и акцентной точкой.
--  - Круглые кнопки управления окном с hover-подсветкой (закрытие — красным).
--  - Вкладки: акцентная полоска-индикатор слева у активной вкладки + hover.
--  - Toggle переделан в pill-переключатель со скользящим кружком (было —
--    плоский квадратный индикатор).
--  - Slider получил скруглённый трек и круглую "ручку" с акцентным ободком.
--  - ColorPicker показывает HEX-код выбранного цвета рядом со свотчем.
--  - Dropdown/MultiDropdown: стрелка плавно вращается на 180° при открытии,
--    добавлены hover-состояния и чекмарки для выбранных пунктов.
--  - Единый hover-эффект (плавное осветление фона) на всех кликабельных
--    элементах: Button, Dropdown, Keybind, ColorPicker-свотч, вкладки.
--  - Уведомления получили акцентную полосу слева вместо только прогресс-бара.
--  - Внутренние отступы страниц вкладок и увеличенный зазор между элементами.
-- ==========================================
--
-- HOTFIX v5.1.1:
--  [FIX] Тень окна больше не "зависает" на экране после скрытия окна (✕ /
--        window:Toggle()) — она отдельный Frame рядом с MainFrame, и раньше
--        не наследовала его видимость.
--  [FIX] Все Unicode-глифы (✕, ‹, ›, –, ▼, ✓), которых нет в шрифте Gotham и
--        которые Roblox рисовал как "квадрат"-заглушку, заменены на обычные
--        ASCII-символы (X, <, >, -, v).
-- ==========================================
--
-- HOTFIX v5.1.2:
--  [FIX] "Ctrl не работает": Roblox различает LeftControl и RightControl как
--        разные клавиши, а привязывался только один вариант. Теперь Keybind
--        при биндинге Ctrl/Shift/Alt автоматически регистрирует ОБА варианта
--        (Left и Right) — срабатывает независимо от того, какой физически
--        нажат. Кнопка бинда в этом случае показывает общее имя ("Control")
--        без уточнения стороны.
--  [FEATURE] Пока открыто хотя бы одно окно originLIB, курсор мыши гарантированно
--        виден и разлочен (UserInputService.MouseIconEnabled/MouseBehavior),
--        даже если камера/прицел игры до этого держали его залоченным. Как
--        только закрывается последнее открытое окно — исходное поведение
--        курсора полностью восстанавливается. Корректно работает и при
--        нескольких одновременно открытых окнах (многооконный режим).
-- ==========================================
--
-- FEATURE v5.2 "Realtime Glass Blur":
--  Во встроенную вкладку GUI Settings добавлены:
--   - Toggle "Background Blur" — включает/выключает размытие фона в реальном
--     времени (Lighting.BlurEffect на весь экран, позади интерфейса — сам
--     GUI при этом остаётся чётким, т.к. рендерится поверх пост-эффектов).
--   - Slider "Blur Intensity" (0–24) — настраивает интенсивность размытия.
--  Блюр автоматически выключается, когда закрывается последнее открытое
--  окно, и включается заново при открытии, если настройка активна. Доступен
--  и программно: originLIB:SetBlurEnabled(bool), originLIB:SetBlurSize(0..24).
-- ==========================================

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")

local originLIB = {
    Windows = {},            -- все живые окна (для UnloadAll / многооконности)
    GlobalUnloadTasks = {},  -- таски, зарегистрированные через originLIB:OnUnload
    NotificationHolder = nil,
    NotifGui = nil,
    _openWindowCount = 0,
    _savedMouseIconEnabled = nil,
    _savedMouseBehavior = nil,
    _blurEnabled = false,   -- включён ли Realtime Glass Blur в GUI Settings
    _blurSize = 12,         -- текущая интенсивность блюра
    BlurEffect = nil,       -- Lighting.BlurEffect, создаётся лениво при первом включении
}
originLIB.__index = originLIB

-- FEATURE: пока открыто хотя бы одно окно originLIB, курсор мыши должен быть
-- виден и свободен (не залочен камерой/прицелом игры), иначе пользователь
-- физически не может кликать по интерфейсу. Как только закрывается ПОСЛЕДНЕЕ
-- открытое окно — исходное поведение мыши (в т.ч. её кастомный лок, если он
-- был в игре) полностью восстанавливается. Считаем через delta (+1/-1), а не
-- через плоский Visible-флаг, чтобы это корректно работало при нескольких
-- одновременно открытых окнах (многооконный режим).
function originLIB:_adjustMouseCapture(delta)
    local before = self._openWindowCount
    self._openWindowCount = math.max(0, before + delta)

    if before == 0 and self._openWindowCount > 0 then
        self._savedMouseIconEnabled = UserInputService.MouseIconEnabled
        self._savedMouseBehavior = UserInputService.MouseBehavior
        UserInputService.MouseIconEnabled = true
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    elseif before > 0 and self._openWindowCount == 0 then
        if self._savedMouseBehavior ~= nil then
            UserInputService.MouseBehavior = self._savedMouseBehavior
        end
        if self._savedMouseIconEnabled ~= nil then
            UserInputService.MouseIconEnabled = self._savedMouseIconEnabled
        end
    end

    -- Блюр должен погаснуть вместе с последним закрытым окном, даже если
    -- переключатель "Background Blur" остался включён в настройках.
    self:_applyBlurState()
end

local WindowClass = {}
WindowClass.__index = WindowClass

local TabClass = {}
TabClass.__index = TabClass

-- ==========================================
-- УТИЛИТЫ
-- ==========================================

-- FIX: "Ctrl не работает" почти всегда означает, что физически нажимается
-- ЛЕВЫЙ Control, а привязана только RightControl (Roblox различает их как
-- разные KeyCode). То же касается Shift/Alt. Регистрируя биндинг клавиши,
-- мы автоматически привязываем и её "пару", чтобы неважно было, какой именно
-- физический Ctrl/Shift/Alt нажал пользователь.
local PAIRED_KEYS = {
    [Enum.KeyCode.LeftControl] = Enum.KeyCode.RightControl,
    [Enum.KeyCode.RightControl] = Enum.KeyCode.LeftControl,
    [Enum.KeyCode.LeftShift] = Enum.KeyCode.RightShift,
    [Enum.KeyCode.RightShift] = Enum.KeyCode.LeftShift,
    [Enum.KeyCode.LeftAlt] = Enum.KeyCode.RightAlt,
    [Enum.KeyCode.RightAlt] = Enum.KeyCode.LeftAlt,
}

local function tween(object, properties, duration)
    local info = TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

local function protectUI(gui)
    if syn and syn.protect_gui then
        syn.protect_gui(gui)
        gui.Parent = CoreGui
    elseif gethui then
        gui.Parent = gethui()
    else
        gui.Parent = CoreGui
    end
end

-- Безопасный вызов пользовательского колбэка: ошибка в нём не должна ронять UI
local function safeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[originLIB] Ошибка в колбэке: " .. tostring(err))
    end
end

-- ===== ВИЗУАЛЬНЫЕ ХЕЛПЕРЫ (v5.1 "Visual Overhaul") =====

-- Осветляет/затемняет цвет на amt (-1..1). Используется для hover-состояний.
local function shade(color, amt)
    amt = amt or 0.08
    return Color3.new(
        math.clamp(color.R + amt, 0, 1),
        math.clamp(color.G + amt, 0, 1),
        math.clamp(color.B + amt, 0, 1)
    )
end

-- Вешает единообразный hover-эффект (плавное осветление фона) на любой GuiObject.
-- getBaseColor — функция, возвращающая ТЕКУЩИЙ базовый цвет (а не застывший
-- снимок), чтобы hover корректно работал даже после смены темы в рантайме.
local function addHover(instance, getBaseColor, amt)
    instance.MouseEnter:Connect(function()
        tween(instance, {BackgroundColor3 = shade(getBaseColor(), amt or 0.07)}, 0.12)
    end)
    instance.MouseLeave:Connect(function()
        tween(instance, {BackgroundColor3 = getBaseColor()}, 0.12)
    end)
end

-- Rgb -> "#RRGGBB", для подписи выбранного цвета в ColorPicker.
local function toHex(color)
    return string.format("#%02X%02X%02X", color.R * 255, color.G * 255, color.B * 255)
end

-- ==========================================
-- REALTIME GLASS BLUR
-- Единый на всю библиотеку Lighting.BlurEffect, создаётся лениво. Блюрит
-- весь экран позади интерфейса (у Roblox нет per-панельного backdrop-filter,
-- поэтому "стеклянный" эффект в реальном времени делается именно так —
-- тем же способом, что и в большинстве Rayfield/Fluent-подобных хабов).
-- Работает как общий "рубильник": включён, пока настройка активна И открыто
-- хотя бы одно окно (см. originLIB:_adjustMouseCapture).
-- ==========================================
function originLIB:_applyBlurState()
    local shouldBlur = self._blurEnabled and self._openWindowCount > 0

    if shouldBlur and not self.BlurEffect then
        local blur = Instance.new("BlurEffect")
        blur.Name = "originLIB_GlassBlur"
        blur.Size = 0
        blur.Parent = Lighting
        self.BlurEffect = blur
    end

    if not self.BlurEffect then return end

    if shouldBlur then
        self.BlurEffect.Enabled = true
        tween(self.BlurEffect, {Size = self._blurSize}, 0.25)
    else
        local anim = tween(self.BlurEffect, {Size = 0}, 0.25)
        anim.Completed:Connect(function()
            if self.BlurEffect then
                self.BlurEffect.Enabled = false
            end
        end)
    end
end

-- Включить/выключить Realtime Glass Blur (вызывается тогглом в GUI Settings,
-- но доступен и напрямую, если нужно управлять им из своего кода).
function originLIB:SetBlurEnabled(state)
    self._blurEnabled = state and true or false
    self:_applyBlurState()
end

-- Изменить интенсивность блюра (0–24, как у стандартного Lighting.BlurEffect.Size).
function originLIB:SetBlurSize(size)
    self._blurSize = math.clamp(size, 0, 24)
    if self._blurEnabled and self.BlurEffect then
        tween(self.BlurEffect, {Size = self._blurSize}, 0.15)
    end
end

