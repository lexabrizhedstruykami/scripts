        if tabsHidden then
            ToggleTabsBtn.Text = ">"
            tween(TabBar, {Position = UDim2.new(0, -130, 0, 35)})
            tween(PagesFolder, {Position = UDim2.new(0, 10, 0, 40), Size = UDim2.new(1, -20, 1, -45)})
        else
            ToggleTabsBtn.Text = "<"
            tween(TabBar, {Position = UDim2.new(0, 0, 0, 35)})
            tween(PagesFolder, {Position = UDim2.new(0, 135, 0, 40), Size = UDim2.new(1, -140, 1, -45)})
        end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
    end)

    function window:Toggle()
        MainFrame.Visible = not MainFrame.Visible
    end

    window.ScreenGui = ScreenGui
    window.MainFrame = MainFrame
    window.TabScroll = TabScroll
    window.PagesFolder = PagesFolder
    window.ResizeHandle = ResizeHandle
    window.SetAllowResize = function(val)
        allowResizeSetting = val
        if not isMinimized then ResizeHandle.Visible = val end
    end

    if not options.DisableSettings and not options.disablesettings then
        window:BuildSettingsTab()
    end

    return window
end

function WindowClass:UpdateThemeColor(category, color)
    self.Theme[category] = color
    if self.ThemeElements[category] then
        for _, obj in ipairs(self.ThemeElements[category]) do
            if obj:IsA("UIStroke") then
                tween(obj, {Color = color})
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                if category == "Accent" and obj:GetAttribute("IsActiveTab") then
                    tween(obj, {BackgroundColor3 = color})
                end
            else
                tween(obj, {BackgroundColor3 = color})
            end
        end
    end
end

-- ==========================================
-- 4. UNLOAD ОКНА & GUI SETTINGS
-- ==========================================

-- Регистрирует функцию очистки, которая выполнится, когда закроется ИМЕННО
-- это окно (в отличие от originLIB:OnUnload, которая общая для всего скрипта).
function WindowClass:OnUnload(taskFunc)
    if type(taskFunc) == "function" then
        table.insert(self.UnloadTasks, taskFunc)
    end
end

-- Выгружает только это окно: выключает его тогглы, выполняет его собственные
-- OnUnload-таски, отключает все подключения UserInputService и уничтожает GUI.
-- Остальные открытые окна (если это многооконный скрипт) не затрагиваются.
function WindowClass:Unload()
    for _, toggleData in ipairs(self.Toggles) do
        if toggleData.IsOn() then
            toggleData.SetState(false)
        end
    end

    for _, taskFunc in ipairs(self.UnloadTasks) do
        safeCall(taskFunc)
    end

    for _, conn in ipairs(self.Connections) do
        if conn.Connected then
            conn:Disconnect()
        end
    end

    -- Destroy() не эмитит сигнал изменения Visible, поэтому если окно
    -- выгружается в открытом состоянии, счётчик "открытых окон" нужно
    -- уменьшить явно — иначе курсор мыши может остаться разлоченным навсегда.
    if self.MainFrame and self.MainFrame.Visible then
        originLIB:_adjustMouseCapture(-1)
    end

    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end

    for i, w in ipairs(originLIB.Windows) do
        if w == self then
            table.remove(originLIB.Windows, i)
            break
        end
    end
end

function WindowClass:BuildSettingsTab()
    local settingsTab = self:Tab("GUI Settings", 9999)

    settingsTab:Keybind("Menu Toggle Key", Enum.KeyCode.RightControl, function()
        self:Toggle()
    end)

    settingsTab:Toggle("Allow Window Resize", false, function(state)
        self.SetAllowResize(state)
    end)

    settingsTab:ColorPicker("Accent Color", self.Theme.Accent, function(col)
        self:UpdateThemeColor("Accent", col)
    end)

    settingsTab:ColorPicker("Background Color", self.Theme.Background, function(col)
        self:UpdateThemeColor("Background", col)
    end)

    settingsTab:ColorPicker("TopBar Color", self.Theme.TopBar, function(col)
        self:UpdateThemeColor("TopBar", col)
    end)

    settingsTab:ColorPicker("Element Background", self.Theme.Element, function(col)
        self:UpdateThemeColor("Element", col)
    end)

    settingsTab:Slider("Corner Radius", 0, 12, 6, function(val)
        for _, corner in ipairs(self.ThemeElements.Corners) do
            corner.CornerRadius = UDim.new(0, val)
        end
    end)

    settingsTab:Section("Эффекты")

    -- FEATURE: Realtime Glass Blur — размывает весь экран позади интерфейса
    -- (единый Lighting.BlurEffect на всю библиотеку, см. originLIB:_applyBlurState).
    -- Настройка общая для всех открытых окон, т.к. это эффект на весь экран,
    -- а не конкретной панели.
    settingsTab:Toggle("Background Blur", false, function(state)
        originLIB:SetBlurEnabled(state)
    end)

    settingsTab:Slider("Blur Intensity", 0, 24, 12, function(val)
        originLIB:SetBlurSize(val)
    end)

    -- Кнопка выгружает ВЕСЬ скрипт целиком (все окна + глобальные таски),
    -- как и в v4.0 — для точечной выгрузки одного окна используйте window:Unload().
    settingsTab:Button("Unload Script", function()
        originLIB:Unload()
    end)
end

