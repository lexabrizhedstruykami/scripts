function TabClass:Keybind(text, defaultKey, callback)
    local currentKey = defaultKey or Enum.KeyCode.RightControl
    local window = self.Window

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -5, 0, 32)
    Frame.BackgroundColor3 = window.Theme.Element
    Frame.Parent = self.Page
    table.insert(window.ThemeElements.Element, Frame)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame
    table.insert(window.ThemeElements.Corners, Corner)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.6, 0, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(230, 230, 230)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local BindBtn = Instance.new("TextButton")
    BindBtn.Size = UDim2.new(0, 90, 0, 22)
    BindBtn.Position = UDim2.new(1, -95, 0.5, -11)
    BindBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    BindBtn.TextColor3 = window.Theme.Accent
    BindBtn.Font = Enum.Font.GothamBold
    BindBtn.TextSize = 11
    BindBtn.Parent = Frame

    local BindCorner = Instance.new("UICorner")
    BindCorner.CornerRadius = UDim.new(0, 4)
    BindCorner.Parent = BindBtn

    addHover(BindBtn, function() return Color3.fromRGB(20, 20, 26) end)

    -- Для клавиш с "парой" (Ctrl/Shift/Alt) показываем общее имя без
    -- Left/Right — раз работают оба физических варианта, отдельно уточнять
    -- сторону только сбивает с толку.
    local FRIENDLY_NAMES = {
        [Enum.KeyCode.LeftControl] = "Control", [Enum.KeyCode.RightControl] = "Control",
        [Enum.KeyCode.LeftShift] = "Shift", [Enum.KeyCode.RightShift] = "Shift",
        [Enum.KeyCode.LeftAlt] = "Alt", [Enum.KeyCode.RightAlt] = "Alt",
    }
    local function friendlyKeyName(key)
        return FRIENDLY_NAMES[key] or key.Name
    end
    BindBtn.Text = friendlyKeyName(currentKey)

    -- PERF+FIX: раньше каждый Keybind вешал СВОЁ persistent-подключение к
    -- UserInputService.InputBegan (утечка) и не имел способа отменить захват
    -- клавиши. Теперь регистрация идёт в общий window.KeybindMap (O(1) диспатч
    -- по KeyCode), а захват клавиши обрабатывается единым обработчиком окна.
    --
    -- FIX: "Ctrl не работает" — привязывалась только RightControl, а на
    -- клавиатуре пользователя фактически нажимался LeftControl (или наоборот).
    -- Теперь при биндинге LeftControl/RightControl (и аналогично Shift/Alt)
    -- регистрируется СРАЗУ ОБА варианта — какой физически ни нажми, сработает.
    local function registerKey(key)
        window.KeybindMap[key] = window.KeybindMap[key] or {}
        table.insert(window.KeybindMap[key], callback)

        local pair = PAIRED_KEYS[key]
        if pair then
            window.KeybindMap[pair] = window.KeybindMap[pair] or {}
            table.insert(window.KeybindMap[pair], callback)
        end
    end

    local function unregisterKey(key)
        local function removeFrom(bucketKey)
            local bucket = window.KeybindMap[bucketKey]
            if not bucket then return end
            for i, cb in ipairs(bucket) do
                if cb == callback then
                    table.remove(bucket, i)
                    break
                end
            end
        end
        removeFrom(key)
        local pair = PAIRED_KEYS[key]
        if pair then removeFrom(pair) end
    end

    registerKey(currentKey)

    BindBtn.MouseButton1Click:Connect(function()
        if window.ListeningKeybind then
            -- если уже что-то слушаем (в т.ч. этот же элемент) — отменяем
            window.ListeningKeybind.Cancel()
        end
        BindBtn.Text = "Press key..."
        window.ListeningKeybind = {
            Bind = function(newKey)
                unregisterKey(currentKey)
                currentKey = newKey
                registerKey(currentKey)
                BindBtn.Text = friendlyKeyName(currentKey)
            end,
            Cancel = function()
                BindBtn.Text = friendlyKeyName(currentKey)
            end
        }
    end)

    return {
        GetKey = function() return currentKey end
    }
end

