    SelectedCorner.CornerRadius = UDim.new(0, 4)
    SelectedCorner.Parent = SelectedBtn

    local SelectedLabel = Instance.new("TextLabel")
    SelectedLabel.Size = UDim2.new(1, -22, 1, 0)
    SelectedLabel.Position = UDim2.new(0, 8, 0, 0)
    SelectedLabel.BackgroundTransparency = 1
    SelectedLabel.Text = tostring(selected)
    SelectedLabel.TextColor3 = window.Theme.Accent
    SelectedLabel.Font = Enum.Font.GothamBold
    SelectedLabel.TextSize = 11
    SelectedLabel.TextXAlignment = Enum.TextXAlignment.Left
    SelectedLabel.TextTruncate = Enum.TextTruncate.AtEnd
    SelectedLabel.Parent = SelectedBtn

    -- Стрелка вынесена в отдельный лейбл, чтобы плавно вращать её на 180°
    -- при открытии/закрытии списка (мелкая деталь, но заметно "живит" UI).
    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 16, 1, 0)
    Arrow.Position = UDim2.new(1, -18, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "v"
    Arrow.TextColor3 = window.Theme.Accent
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 10
    Arrow.Parent = SelectedBtn

    addHover(SelectedBtn, function() return Color3.fromRGB(20, 20, 26) end)

    local ListHolder = Instance.new("ScrollingFrame")
    ListHolder.Size = UDim2.new(1, -20, 0, 0)
    ListHolder.Position = UDim2.new(0, 10, 0, 35)
    ListHolder.BackgroundTransparency = 1
    ListHolder.ScrollBarThickness = 2
    ListHolder.Parent = Frame

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Padding = UDim.new(0, 3)
    ListLayout.Parent = ListHolder

    local isOpen = false
    local entry -- ссылка на регистрационную запись в window.Dropdowns (см. ниже)

    local function setOpen(open)
        isOpen = open
        local targetHeight = math.min(#options * 25, 100)
        ListHolder.Size = UDim2.new(1, -20, 0, isOpen and targetHeight or 0)
        ListHolder.CanvasSize = UDim2.new(0, 0, 0, #options * 25)
        tween(Frame, {Size = isOpen and UDim2.new(1, -5, 0, 40 + targetHeight) or UDim2.new(1, -5, 0, 32)})
        tween(Arrow, {Rotation = isOpen and 180 or 0}, 0.15)
    end

    local function toggleDropdown()
        if not isOpen then
            -- FEATURE: при открытии этого списка закрываем все остальные
            -- открытые Dropdown/MultiDropdown в этом же окне.
            window:CloseOtherDropdowns(entry)
        end
        setOpen(not isOpen)
    end

    entry = { Close = function() if isOpen then setOpen(false) end end }
    table.insert(window.Dropdowns, entry)

    SelectedBtn.MouseButton1Click:Connect(toggleDropdown)

    for _, option in ipairs(options) do
        local OptBtn = Instance.new("TextButton")
        OptBtn.Size = UDim2.new(1, -5, 0, 22)
        OptBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
        OptBtn.Text = tostring(option)
        OptBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.TextSize = 11
        OptBtn.Parent = ListHolder

        local OptCorner = Instance.new("UICorner")
        OptCorner.CornerRadius = UDim.new(0, 4)
        OptCorner.Parent = OptBtn

        addHover(OptBtn, function() return Color3.fromRGB(24, 24, 32) end, 0.06)

        OptBtn.MouseButton1Click:Connect(function()
            selected = option
            SelectedLabel.Text = tostring(selected)
            toggleDropdown()
            safeCall(callback, selected)
        end)
    end

    return { GetValue = function() return selected end }
end

-- ---------- MultiDropdown (НОВЫЙ ЭЛЕМЕНТ) ----------
-- Как Dropdown, но позволяет выбрать несколько вариантов одновременно.
-- callback вызывается с массивом выбранных строк при каждом изменении.
function TabClass:MultiDropdown(text, options, defaults, callback)
    options = options or {}
    local window = self.Window
    local selectedSet = {}
    for _, v in ipairs(defaults or {}) do selectedSet[v] = true end

    local function selectedList()
        local list = {}
        for _, opt in ipairs(options) do
            if selectedSet[opt] then table.insert(list, opt) end
        end
        return list
    end

    local function summaryText()
        local list = selectedList()
        if #list == 0 then return "None  ▼" end
        if #list == 1 then return list[1] .. "  ▼" end
        return (#list .. " selected  ▼")
    end

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -5, 0, 32)
    Frame.BackgroundColor3 = window.Theme.Element
    Frame.ClipsDescendants = true
    Frame.Parent = self.Page
    table.insert(window.ThemeElements.Element, Frame)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame
    table.insert(window.ThemeElements.Corners, Corner)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.4, 0, 0, 32)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(230, 230, 230)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local SelectedBtn = Instance.new("TextButton")
    SelectedBtn.Size = UDim2.new(0.55, 0, 0, 22)
    SelectedBtn.Position = UDim2.new(0.42, 0, 0, 5)
    SelectedBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    SelectedBtn.Text = ""
    SelectedBtn.AutoButtonColor = false
    SelectedBtn.Parent = Frame

    local SelectedCorner = Instance.new("UICorner")
    SelectedCorner.CornerRadius = UDim.new(0, 4)
    SelectedCorner.Parent = SelectedBtn

    local SelectedLabel = Instance.new("TextLabel")
    SelectedLabel.Size = UDim2.new(1, -22, 1, 0)
    SelectedLabel.Position = UDim2.new(0, 8, 0, 0)
    SelectedLabel.BackgroundTransparency = 1
    SelectedLabel.Text = summaryText()
    SelectedLabel.TextColor3 = window.Theme.Accent
    SelectedLabel.Font = Enum.Font.GothamBold
    SelectedLabel.TextSize = 11
    SelectedLabel.TextXAlignment = Enum.TextXAlignment.Left
    SelectedLabel.TextTruncate = Enum.TextTruncate.AtEnd
    SelectedLabel.Parent = SelectedBtn

    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 16, 1, 0)
    Arrow.Position = UDim2.new(1, -18, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "v"
    Arrow.TextColor3 = window.Theme.Accent
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 10
    Arrow.Parent = SelectedBtn

    addHover(SelectedBtn, function() return Color3.fromRGB(20, 20, 26) end)

    local ListHolder = Instance.new("ScrollingFrame")
    ListHolder.Size = UDim2.new(1, -20, 0, 0)
    ListHolder.Position = UDim2.new(0, 10, 0, 35)
    ListHolder.BackgroundTransparency = 1
    ListHolder.ScrollBarThickness = 2
    ListHolder.Parent = Frame

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Padding = UDim.new(0, 3)
    ListLayout.Parent = ListHolder

    local isOpen = false
    local entry

    local function setOpen(open)
        isOpen = open
        local targetHeight = math.min(#options * 25, 100)
        ListHolder.Size = UDim2.new(1, -20, 0, isOpen and targetHeight or 0)
        ListHolder.CanvasSize = UDim2.new(0, 0, 0, #options * 25)
        tween(Frame, {Size = isOpen and UDim2.new(1, -5, 0, 40 + targetHeight) or UDim2.new(1, -5, 0, 32)})
        tween(Arrow, {Rotation = isOpen and 180 or 0}, 0.15)
    end

    local function toggleDropdown()
        if not isOpen then
            window:CloseOtherDropdowns(entry)
        end
        setOpen(not isOpen)
    end

    entry = { Close = function() if isOpen then setOpen(false) end end }
    table.insert(window.Dropdowns, entry)

    SelectedBtn.MouseButton1Click:Connect(toggleDropdown)

    for _, option in ipairs(options) do
        local OptBtn = Instance.new("TextButton")
        OptBtn.Size = UDim2.new(1, -5, 0, 22)
        OptBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
        OptBtn.Text = ""
        OptBtn.AutoButtonColor = false
        OptBtn.Parent = ListHolder

        local OptCorner = Instance.new("UICorner")
        OptCorner.CornerRadius = UDim.new(0, 4)
        OptCorner.Parent = OptBtn

        local OptLabel = Instance.new("TextLabel")
        OptLabel.Size = UDim2.new(1, -26, 1, 0)
        OptLabel.Position = UDim2.new(0, 8, 0, 0)
        OptLabel.BackgroundTransparency = 1
        OptLabel.Text = tostring(option)
        OptLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        OptLabel.Font = Enum.Font.Gotham
        OptLabel.TextSize = 11
        OptLabel.TextXAlignment = Enum.TextXAlignment.Left
        OptLabel.Parent = OptBtn

        local Check = Instance.new("TextLabel")
        Check.Size = UDim2.new(0, 18, 1, 0)
        Check.Position = UDim2.new(1, -20, 0, 0)
        Check.BackgroundTransparency = 1
        Check.Text = selectedSet[option] and "X" or ""
        Check.TextColor3 = window.Theme.Accent
        Check.Font = Enum.Font.GothamBold
        Check.TextSize = 12
        Check.Parent = OptBtn

        addHover(OptBtn, function() return Color3.fromRGB(24, 24, 32) end, 0.06)

        OptBtn.MouseButton1Click:Connect(function()
            selectedSet[option] = not selectedSet[option] or nil
            Check.Text = selectedSet[option] and "X" or ""
            SelectedLabel.Text = summaryText()
            safeCall(callback, selectedList())
        end)
    end

    return { GetValues = selectedList }
end

-- ---------- Paragraph ----------
function TabClass:Paragraph(title, content)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -5, 0, 50)
    Frame.BackgroundColor3 = self.Window.Theme.Element
    Frame.Parent = self.Page
    table.insert(self.Window.ThemeElements.Element, Frame)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame
    table.insert(self.Window.ThemeElements.Corners, Corner)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -20, 0, 20)
    TitleLabel.Position = UDim2.new(0, 10, 0, 4)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = title or "Title"
    TitleLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = Frame

    local ContentLabel = Instance.new("TextLabel")
    ContentLabel.Size = UDim2.new(1, -20, 0, 24)
    ContentLabel.Position = UDim2.new(0, 10, 0, 22)
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.Text = content or ""
    ContentLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
    ContentLabel.Font = Enum.Font.Gotham
    ContentLabel.TextSize = 11
    ContentLabel.TextWrapped = true
    ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
    ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
    ContentLabel.Parent = Frame
end

-- ---------- Section ----------
function TabClass:Section(text)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -5, 0, 26)
    Frame.BackgroundTransparency = 1
    Frame.Parent = self.Page

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 16)
    Label.BackgroundTransparency = 1
    Label.Text = string.upper(text or "SECTION")
    Label.TextColor3 = self.Window.Theme.Accent
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 10
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    table.insert(self.Window.ThemeElements.Accent, Label)

    local Line = Instance.new("Frame")
    Line.Size = UDim2.new(1, 0, 0, 1)
    Line.Position = UDim2.new(0, 0, 1, -4)
    Line.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    Line.BorderSizePixel = 0
    Line.Parent = Frame
end

-- ---------- Label (НОВЫЙ ЭЛЕМЕНТ) ----------
-- Простая статичная строка текста без фона — для коротких подсказок между
-- элементами, когда полноценный Paragraph избыточен.
function TabClass:Label(text)
    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1, -10, 0, 18)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = text or ""
    Lbl.TextColor3 = Color3.fromRGB(170, 170, 190)
    Lbl.Font = Enum.Font.Gotham
    Lbl.TextSize = 12
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.TextWrapped = true
    Lbl.Parent = self.Page
    return Lbl
end

-- ---------- Divider (НОВЫЙ ЭЛЕМЕНТ) ----------
-- Тонкая горизонтальная линия для визуального разделения блоков без заголовка.
function TabClass:Divider()
    local Holder = Instance.new("Frame")
    Holder.Size = UDim2.new(1, -5, 0, 9)
    Holder.BackgroundTransparency = 1
    Holder.Parent = self.Page

    local Line = Instance.new("Frame")
    Line.Size = UDim2.new(1, 0, 0, 1)
    Line.Position = UDim2.new(0, 0, 0.5, 0)
    Line.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    Line.BorderSizePixel = 0
    Line.Parent = Holder
end

