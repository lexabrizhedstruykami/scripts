        Page.Visible = true
        TabBtn:SetAttribute("IsActiveTab", true)
        -- Активная вкладка: чуть более светлый фон + акцентная полоска слева +
        -- белый текст. Не заливаем кнопку сплошным акцентом, иначе полоска
        -- индикатора попросту сольётся с фоном того же цвета.
        tween(TabBtn, {BackgroundColor3 = shade(self.Theme.Element, 0.06)})
        tween(TabLabel, {TextColor3 = Color3.fromRGB(255, 255, 255)})
        tween(Indicator, {Size = UDim2.new(0, 3, 1, -10)})
    end

    TabBtn.MouseButton1Click:Connect(activate)

    if #self.Tabs == 0 then
        activate()
    end

    table.insert(self.Tabs, {Btn = TabBtn, Page = Page, Label = TabLabel, Indicator = Indicator})

    selfTab.Page = Page
    return selfTab
end

