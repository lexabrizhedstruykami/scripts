        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * pos)
        Fill.Size = UDim2.new(pos, 0, 1, 0)
        Thumb.Position = UDim2.new(pos, 0, 0.5, 0)
        ValLabel.Text = tostring(value)
        safeCall(callback, value)
    end

    -- FIX: раньше слушался Frame.InputBegan (вся строка), из-за чего клик по
    -- подписи "Скорость бега" тоже двигал ползунок. Теперь — только сам Bar.
    -- PERF: перетаскивание диспатчится через единый window.DragState, а не
    -- через собственное подключение к UserInputService.InputChanged.
    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            update(input)
            self.Window.DragState = { Update = update }
        end
    end)

    return { GetValue = function() return math.floor(min + (max - min) * (Fill.Size.X.Scale)) end }
end

